# Copy to .env. All values are for local demo use only.
PORT=3000
# At least 32 characters. Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
DB_PATH=./data/novra.db
GYM_CAPACITY=85
GYM_TIMEZONE=Europe/Istanbul
# Demo mode: fictional members walk in and out, scripted buddies use the radar. Never in production.
DEMO_SIMULATION=false
DEMO_MIN_INSIDE=12
