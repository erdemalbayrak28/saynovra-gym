{
  "name": "novra-gym-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/index.ts",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/index.ts",
    "seed": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/seed.ts",
    "test": "node --test --disable-warning=ExperimentalWarning \"test/**/*.test.ts\"",
    "coverage": "node --test --experimental-test-coverage --disable-warning=ExperimentalWarning \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.17",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@noble/hashes": "^2.4.0",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  }
}
